PORT=3008

# Auth0 Event Stream (Webhook) の Authorization Token と照合する共有シークレット。
# Auth0のEvent Stream設定画面は Authorization フィールドの値に自動で "Bearer " を前置するため、
# ここには "Bearer " を含めない生のシークレットだけを設定する（付与はsrc/index.ts側で行う）。
EVENT_STREAM_TOKEN=YOUR_SHARED_SECRET

# NexusCRM User Sync M2Mアプリのドメイン・audience（services/userのAUTH0_AUDIENCEと同じ値）・資格情報
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN.auth0.com
AUTH0_AUDIENCE=https://api.nexuscrm.com
AUTH0_SYNC_CLIENT_ID=YOUR_M2M_CLIENT_ID
AUTH0_SYNC_CLIENT_SECRET=YOUR_M2M_CLIENT_SECRET

USER_SERVICE_URL=http://localhost:3005
